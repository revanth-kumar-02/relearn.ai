{
  "name": "relearn-ide",
  "version": "1.0.0",
  "private": true,
  "license": "EPL-2.0",
  "dependencies": {
    "@theia/core": "^1.50.0",
    "@theia/editor": "^1.50.0",
    "@theia/filesystem": "^1.50.0",
    "@theia/file-search": "^1.50.0",
    "@theia/markers": "^1.50.0",
    "@theia/messages": "^1.50.0",
    "@theia/monaco": "^1.50.0",
    "@theia/navigator": "^1.50.0",
    "@theia/preferences": "^1.50.0",
    "@theia/process": "^1.50.0",
    "@theia/terminal": "^1.50.0",
    "@theia/vsx-registry": "^1.50.0",
    "@theia/workspace": "^1.50.0"
  },
  "devDependencies": {
    "@theia/cli": "^1.50.0",
    "typescript": "~5.3.3"
  },
  "scripts": {
    "build": "theia build --mode production",
    "start": "theia start --hostname=0.0.0.0 --port=3000 /home/project"
  },
  "theia": {
    "frontend": {
      "config": {
        "applicationName": "Relearn.ai Engineering Studio",
        "defaultTheme": "dark",
        "preferences": {
          "workbench.colorTheme": "Default Dark Modern",
          "editor.fontSize": 13,
          "editor.fontFamily": "'JetBrains Mono', 'Fira Code', Menlo, Monaco, monospace",
          "editor.tabSize": 2,
          "terminal.integrated.fontFamily": "'JetBrains Mono', 'Fira Code', Menlo, Monaco, monospace",
          "terminal.integrated.defaultProfile.linux": "bash",
          "terminal.integrated.fontSize": 12
        }
      }
    }
  }
}
